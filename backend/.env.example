# Copy to backend/.env — never commit the real file.

# Required for waitlist confirmation emails (https://resend.com)
RESEND_API_KEY=re_xxxxxxxx

# Must be a verified sender in Resend (domain or onboarding@resend.dev for testing)
WAITLIST_FROM_EMAIL=Engel <hello@yourdomain.com>
WAITLIST_REPLY_TO=arssh.kumar10@gmail.com

# Public URL of this API (no trailing slash) — used in confirmation email links
PUBLIC_API_BASE_URL=https://<your-engel-api>.up.railway.app

# Where users land after clicking the confirm link
WAITLIST_SUCCESS_URL=https://a-kumar14.github.io/engel/confirmed.html

# Comma-separated origins allowed to call POST /api/waitlist/subscribe
CORS_ORIGINS=https://a-kumar14.github.io,http://127.0.0.1:8080,http://localhost:8080

DATABASE_URL=sqlite:///./engel.db

# Optional — app features
OPENROUTER_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
